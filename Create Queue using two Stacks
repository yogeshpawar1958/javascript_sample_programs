
var stack1=[]
var stack2=[]

function inqueue(value){
    stack1.push(value)
}

function dequeue(){
    if(stack2.length===0){
        while(stack1.length>0){
            stack2.push(stack1.pop())
        }
    }
    if(stack2.length==0){
        console.log("queue is empty")
    }
    console.log( stack2.pop())
}
function checkFront(){
    if(stack2.length){
        console.log(stack2[stack2.length-1])
    }else if(stack1.length){
       console.log(stack1[0])
    }else{
        console.log("queue is empty")
    }
}
inqueue(4)//4
inqueue(2)//42
inqueue(7)//427
dequeue()//4
checkFront()//2
